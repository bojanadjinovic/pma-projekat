<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E2C8"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#6B6B4E" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_user"
            android:textSize="14sp"
            android:textColor="#8A8A6A"
            android:layout_marginBottom="16dp" />

        <!-- INGREDIENT OF THE DAY CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ingredient_day"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/ingredient_image_desc"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ingredient_of_day"
                        android:textSize="14sp"
                        android:textColor="#8A8A6A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ingredient_name"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#6B6B4E"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good for: Oily, acne-prone\nAvoid if: Very sensitive (high %)"
                        android:textSize="13sp"
                        android:textColor="#6B6B4E"
                        android:layout_marginTop="6dp" />

                    <Button
                        android:id="@+id/btnLearnMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/learn_more"
                        android:backgroundTint="#C8C49A"
                        android:textColor="#6B6B4E"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- SKIN TYPES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skin Types"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#6B6B4E"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/btnOily"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Oily"
                android:gravity="center"
                android:background="#EFE8B8"
                android:textColor="#6B6B4E"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btnSensitive"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Sensitive"
                android:gravity="center"
                android:background="#EFE8B8"
                android:textColor="#6B6B4E"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btnDry"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Dry"
                android:gravity="center"
                android:background="#EFE8B8"
                android:textColor="#6B6B4E"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- DAILY TIP CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#F4F2E6"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Tip"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#8A8A6A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Never skip Sunscreen!"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#6B6B4E"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Using sunscreen daily is the most effective anti-aging step in your skincare routine. It protects against UV rays and prevents hyperpigmentation."
                    android:textSize="14sp"
                    android:textColor="#6B6B4E"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ROUTINE GUIDE CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#F4F2E6"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Routine Guide"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#8A8A6A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The Core Order"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#6B6B4E"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Cleanser - Wash away impurities.\n2. Toner - Balance skin pH.\n3. Serum - Target specific concerns.\n4. Moisturizer - Lock in hydration.\n5. Sunscreen - Protect during daylight."
                    android:textSize="14sp"
                    android:textColor="#6B6B4E"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>