<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E2C8"
    tools:context=".SearchFragment">

    <!-- 1) START VIEW -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/searchStartLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="32dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#6B6B4E"
                android:layout_marginBottom="16dp"/>

            <!-- SEARCH BAR -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Search ingredient"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:textColor="#333333"/>

            <!-- SUGGESTIONS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try searching for"
                android:textStyle="bold"
                android:textColor="#6B6B4E"
                android:layout_marginTop="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Niacinamide • Retinol • Salicylic Acid"
                android:textColor="#8A8A6A"
                android:layout_marginTop="8dp"/>

            <!-- SKIN TYPE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="By Skin Type"
                android:textStyle="bold"
                android:textColor="#6B6B4E"
                android:layout_marginTop="32dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oily"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="#FFFFFF"
                    android:textColor="#6B6B4E"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sensitive"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="#FFFFFF"
                    android:textColor="#6B6B4E"
                    android:layout_marginStart="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dry"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="#FFFFFF"
                    android:textColor="#6B6B4E"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 2) LIST VIEW (posle klika na search) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6E2C8"
        android:padding="16dp"
        android:visibility="gone"
        tools:listitem="@android:layout/simple_list_item_1"/>

</FrameLayout>